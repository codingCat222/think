# Paystack — get these from https://dashboard.paystack.com/#/settings/developer
# Use TEST keys while building, LIVE keys only once you're ready to go live.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Database connection string (used when you wire up Prisma/Postgres, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/thinkup"

# Object storage (if you move file uploads off local disk)
STORAGE_BUCKET_URL=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
